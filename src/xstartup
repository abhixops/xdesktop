#!/bin/bash
# Default X session for xdesktop (installed as /usr/local/lib/xdesktop/xstartup).
# ~/.vnc/xstartup execs this file by default; replace ~/.vnc/xstartup to customise.
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

# No screen blanking / DPMS: the session has no password to unlock it with.
xset s off 2>/dev/null || true
xset s noblank 2>/dev/null || true
xset -dpms 2>/dev/null || true

if [ -r "${HOME}/.Xresources" ]; then
    xrdb -merge "${HOME}/.Xresources"
fi

# Clipboard sync between the VNC client and X selections (TigerVNC >= 1.10
# also does this inside Xvnc; vncconfig keeps older viewers working).
if command -v vncconfig >/dev/null 2>&1; then
    vncconfig -nowin &
fi

exec startxfce4
