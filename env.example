# xdesktop configuration. Copy to .env and edit:  cp env.example .env
# Every variable is optional; the values shown are the defaults.
# .env is git-ignored. Never commit real passwords.

# ---------------------------------------------------------------------------
# Access / security
# ---------------------------------------------------------------------------

# VNC password. Leave EMPTY to have a random 12-character password generated
# on start and printed ONCE to the logs (docker compose logs xdesktop).
# NOTE: VNC authentication only uses the first 8 characters of the password.
VNC_PW=

# Host address the noVNC port is published on. 127.0.0.1 = this machine only.
# Do not use 0.0.0.0 on an internet-facing host; see examples/caddy instead.
XDESKTOP_BIND=127.0.0.1

# Host port for noVNC (open https://localhost:<port>).
NOVNC_HOST_PORT=6080

# true = noVNC serves HTTPS only. false = also plain HTTP (only behind a
# TLS-terminating reverse proxy such as examples/caddy).
NOVNC_SSL_ONLY=true

# Custom TLS certificate/key paths inside the container (mount them yourself).
# Alternatively mount a combined cert+key PEM at /etc/ssl/novnc.pem.
# Empty = self-signed certificate for localhost/127.0.0.1, auto-renewed.
NOVNC_CERT=
NOVNC_KEY=

# localhost = raw VNC (5901) only reachable inside the container.
# all = Xvnc accepts external connections (see examples/raw-vnc).
VNC_LISTEN=localhost

# Passwordless sudo for the desktop user (true/false).
ENABLE_SUDO=true

# ---------------------------------------------------------------------------
# User
# ---------------------------------------------------------------------------

# Desktop username (also used as build arg). Replaces the old USERNAME variable.
XDESKTOP_USER=xdesktop

# UID/GID of the desktop user. Set these to the owner of ./projects on the host
# (run `id -u` and `id -g`) to avoid permission problems.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Desktop
# ---------------------------------------------------------------------------

RESOLUTION=1920x1080
VNC_DEPTH=24
# X display number; the internal raw VNC port is 5900 + DISPLAY_NUM.
DISPLAY_NUM=1
# noVNC port inside the container.
NOVNC_PORT=6080
TZ=UTC

# Comma-separated VS Code extension IDs, installed in the background on start.
# Example: VSCODE_EXTENSIONS=ms-python.python,eamodio.gitlens
VSCODE_EXTENSIONS=

# ---------------------------------------------------------------------------
# Image / resources
# ---------------------------------------------------------------------------

# Image tag from ghcr.io/abhixops/xdesktop (e.g. latest, v2.0.0).
XDESKTOP_TAG=latest
XDESKTOP_MEMORY=4g
XDESKTOP_CPUS=2
XDESKTOP_SHM_SIZE=1gb

# ---------------------------------------------------------------------------
# Build arguments (only used by `docker compose build`)
# USER_UID/USER_GID are taken from PUID/PGID above.
# ---------------------------------------------------------------------------

INSTALL_VSCODE=true
INSTALL_FIREFOX=true
# Installs docker-ce-cli + compose plugin; see examples/docker-cli.
INSTALL_DOCKER_CLI=false
# Space-separated extra apt packages, e.g. "htop build-essential".
EXTRA_PACKAGES=

# ---------------------------------------------------------------------------
# Optional File Browser (docker compose --profile files up -d)
# ---------------------------------------------------------------------------

FILEBROWSER_PORT=8080
FILEBROWSER_TAG=latest
